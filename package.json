{
  "name": "@quincarter/create-lit-app",
  "version": "1.3.0",
  "description": "Interactive CLI initializer for Lit Element App Shell architecture",
  "keywords": [
    "app-shell",
    "cli",
    "create-lit-app",
    "lit",
    "lit-element",
    "scaffold",
    "signals",
    "vite"
  ],
  "license": "MIT",
  "author": "Quin Carter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quincarter/app-shell-starter.git"
  },
  "man": "./man/create-lit-app.1",
  "bin": {
    "create-app-shell": "./bin/create-lit-app.js",
    "create-lit-app": "./bin/create-lit-app.js"
  },
  "files": [
    "bin/",
    "create-app-shell.sh",
    "man/",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build-cli.ts",
    "fmt": "oxfmt scripts bin package.json tsconfig.json",
    "fmt:check": "oxfmt --check scripts bin package.json tsconfig.json",
    "lint": "oxlint scripts bin",
    "lint:fix": "oxlint --fix scripts bin",
    "test:agents": "bash scripts/test-agent-scaffolding.sh",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish && git push --tags && tsx scripts/sync-releases.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
